# ---------------------------------------------------------------------------
# Main dispatcher
# ---------------------------------------------------------------------------
require_deps

NOUN="${1:-help}"
shift || true

# Nouns that work without a valid DB configured
_no_env_needed="rules workflow db help --help -h"

case "$NOUN" in
  task)
    require_env
    VERB="${1:-list}"; shift || true
    case "$VERB" in
      list)     cmd_task_list "$@" ;;
      show)
        [[ $# -lt 1 ]] && die "Usage: notion task show <No.>"
        cmd_task_show "$1" ;;
      create)   cmd_task_create "$@" ;;
      update)
        [[ $# -lt 3 ]] && die "Usage: notion task update <No.> <property> <value>"
        cmd_task_update "$1" "$2" "$3" ;;
      assign)
        [[ $# -lt 2 ]] && die "Usage: notion task assign <No.> <email[,email,...]>"
        cmd_task_assign "$1" "$2" ;;
      unassign)
        [[ $# -lt 2 ]] && die "Usage: notion task unassign <No.> <email[,email,...]>"
        cmd_task_unassign "$1" "$2" ;;
      *) die "Unknown verb '${VERB}' for 'task'. Try: list, show, create, update, assign, unassign" ;;
    esac
    ;;

  comment)
    require_env
    VERB="${1:-}"; shift || true
    case "$VERB" in
      add)
        [[ $# -lt 2 ]] && die "Usage: notion comment add <No.> \"text\""
        cmd_comment_add "$1" "$2" ;;
      *) die "Unknown verb '${VERB}' for 'comment'. Try: add" ;;
    esac
    ;;

  user)
    require_env
    VERB="${1:-list}"; shift || true
    case "$VERB" in
      list) cmd_user_list ;;
      *) die "Unknown verb '${VERB}' for 'user'. Try: list" ;;
    esac
    ;;

  db)
    VERB="${1:-list}"; shift || true
    case "$VERB" in
      list)      cmd_db_list ;;
      bootstrap)
        if [[ $# -gt 0 && ( "$1" == "--help" || "$1" == "-h" || "$1" == "help" ) ]]; then
          cmd_db_bootstrap_help
        else
          require_env
          cmd_db_bootstrap "$@"
        fi
        ;;
      *) die "Unknown verb '${VERB}' for 'db'. Try: list, bootstrap" ;;
    esac
    ;;

  rules)
    cmd_rules
    ;;

  workflow)
    VERB="${1:-list}"; shift || true
    case "$VERB" in
      list) cmd_workflow_list ;;
      show)
        [[ $# -lt 1 ]] && die "Usage: notion workflow show <name>"
        cmd_workflow_show "$1" ;;
      *) die "Unknown verb '${VERB}' for 'workflow'. Try: list, show" ;;
    esac
    ;;

  help|--help|-h)
    cmd_help
    ;;

  *)
    die "Unknown noun: '${NOUN}'. Run 'notion help' for usage."
    ;;
esac
