#!/usr/bin/env bash
# =============================================================================
# notion — Notion CLI for task management via Notion API
# =============================================================================
# Usage:
#   notion task list                              List tasks grouped by Status
#   notion task list --filter <prop> <val>        Filter tasks
#   notion task list --sort <prop> [asc|desc]     Sort tasks
#   notion task show <No.>                        Show task details + comments
#   notion task create --title "..." [--prop val] Create a task
#   notion task update <No.> <property> <value>   Update a task property
#   notion comment add <No.> "text"               Add a comment
#   notion user list                              List workspace members
#   notion task assign <No.> <email[,email,...]>  Set assignees (replaces all)
#   notion task unassign <No.> <email[,email,..]> Remove specific assignees
#   notion db list                                List DB aliases
#   notion db bootstrap                           Provision DB with standard schema
#   notion db bootstrap --milestone <uuid>        Bootstrap with Milestone relation to another DB
#   notion rules                                  Display workspace best practices
#   notion workflow list                          List available workflows
#   notion workflow show <name>                   Show a specific workflow
#
# --db overrides NOTION_DATABASE_ID for this invocation only.
# Aliases are defined in .env.notion as NOTION_DATABASE_ID:<ALIAS>=<uuid>
# e.g.  NOTION_DATABASE_ID:VENTURES=3da11e67af4180c4...
#       notion --db ventures task list
# =============================================================================

set -uo pipefail

# ---------------------------------------------------------------------------
# Config — load from .env.notion
# ---------------------------------------------------------------------------
ENV_FILE="${PWD}/.env.notion"

if [[ ! -f "$ENV_FILE" ]]; then
  echo -e "\033[31mERROR:\033[0m .env.notion not found in current directory (${PWD})"
  echo ""
  echo "Create .env.notion with:"
  echo "  NOTION_API_KEY=secret_xxxx       # from notion.so/profile/integrations"
  echo "  NOTION_DATABASE_ID=xxxx          # from board URL: notion.so/.../<THIS_PART>?v=..."
  exit 1
fi

# Declare before the parsing loop to avoid set -u issues
declare -A _NOTION_DB_ALIASES=()

while IFS= read -r _line || [[ -n "$_line" ]]; do
  _line="${_line%%#*}"
  _line="${_line//[$'\r']}"
  [[ -z "${_line// }" ]] && continue
  _key="${_line%%=*}"
  _val="${_line#*=}"
  _key="${_key#"${_key%%[![:space:]]*}"}" ; _key="${_key%"${_key##*[![:space:]]}"}"
  _val="${_val#"${_val%%[![:space:]]*}"}" ; _val="${_val%"${_val##*[![:space:]]}"}"
  _val="${_val#\"}" ; _val="${_val%\"}"
  _val="${_val#\'}" ; _val="${_val%\'}"
  if [[ "$_key" =~ ^NOTION_DATABASE_ID:(.+)$ ]]; then
    _alias="${BASH_REMATCH[1],,}"
    _NOTION_DB_ALIASES["$_alias"]="$_val"
  elif [[ "$_key" =~ ^NOTION_ ]]; then
    export "$_key"="$_val"
  fi
done < "$ENV_FILE"
unset _line _key _val

NOTION_API_KEY="${NOTION_API_KEY:-}"
NOTION_DATABASE_ID="${NOTION_DATABASE_ID:-}"
NOTION_USER="${NOTION_USER:-}"
NOTION_USER_EMAIL="${NOTION_USER_EMAIL:-}"
NOTION_STATUS_PROPERTY_NAME="Status"
NOTION_TITLE_PROPERTY_NAME="${NOTION_TITLE_PROPERTY_NAME:-Task name}"
NOTION_VERSION="2022-06-28"
BASE_URL="https://api.notion.com/v1"

# ---------------------------------------------------------------------------
# Early arg parsing — consume --db <id|alias> before the noun
# ---------------------------------------------------------------------------
_DB_OVERRIDE=""
_REMAINING_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --db)
      [[ $# -lt 2 ]] && { echo -e "\033[31mERROR:\033[0m --db requires an argument" >&2; exit 1; }
      _DB_OVERRIDE="$2"; shift; shift ;;
    *) _REMAINING_ARGS+=("$1"); shift ;;
  esac
done
set -- "${_REMAINING_ARGS[@]+"${_REMAINING_ARGS[@]}"}"
unset _REMAINING_ARGS

if [[ -n "$_DB_OVERRIDE" ]]; then
  if [[ "$_DB_OVERRIDE" =~ ^[0-9a-fA-F-]{32,36}$ ]]; then
    NOTION_DATABASE_ID="$_DB_OVERRIDE"
  else
    _alias_lower="${_DB_OVERRIDE,,}"
    _ALIAS_VAL="${_NOTION_DB_ALIASES[$_alias_lower]:-}"
    if [[ -z "$_ALIAS_VAL" ]]; then
      echo -e "\033[31mERROR:\033[0m DB alias '${_DB_OVERRIDE}' not found." >&2
      echo "  Define it in .env.notion as: NOTION_DATABASE_ID:${_DB_OVERRIDE^^}=<uuid>" >&2
      echo "  Run 'notion db list' to see available aliases." >&2
      exit 1
    fi
    NOTION_DATABASE_ID="$_ALIAS_VAL"
    unset _alias_lower _ALIAS_VAL
  fi
fi
unset _DB_OVERRIDE

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------
die()    { echo -e "\033[31mERROR:\033[0m $*" >&2; exit 1; }
info()   { echo -e "\033[36m$*\033[0m"; }
bold()   { echo -e "\033[1m$*\033[0m"; }
dim()    { echo -e "\033[2m$*\033[0m"; }
green()  { echo -e "\033[32m$*\033[0m"; }
yellow() { echo -e "\033[33m$*\033[0m"; }

# ---------------------------------------------------------------------------
# Dependency + env guards
# ---------------------------------------------------------------------------
require_deps() {
  for cmd in curl jq; do
    command -v "$cmd" &>/dev/null || die "'$cmd' is required but not installed."
  done
}

require_env() {
  [[ -z "$NOTION_API_KEY" ]]      && die "NOTION_API_KEY is not set in .env.notion"
  [[ -z "$NOTION_DATABASE_ID" ]]  && die "NOTION_DATABASE_ID is not set in .env.notion"
}

# ---------------------------------------------------------------------------
# API wrappers
# ---------------------------------------------------------------------------
_notion_request() {
  local method="$1"
  local path="$2"
  local body="${3:-}"
  local response

  if [[ "$method" == "GET" ]]; then
    response=$(curl -s \
      -H "Authorization: Bearer ${NOTION_API_KEY}" \
      -H "Notion-Version: ${NOTION_VERSION}" \
      -H "Content-Type: application/json" \
      "${BASE_URL}${path}")
  else
    response=$(curl -s \
      -X "$method" \
      -H "Authorization: Bearer ${NOTION_API_KEY}" \
      -H "Notion-Version: ${NOTION_VERSION}" \
      -H "Content-Type: application/json" \
      --data "${body:-{\}}" \
      "${BASE_URL}${path}")
  fi

  # Surface API errors immediately
  local obj
  obj=$(echo "$response" | jq -r '.object // ""')
  if [[ "$obj" == "error" ]]; then
    local msg
    msg=$(echo "$response" | jq -r '.message // "unknown error"')
    die "Notion API error: $msg"
  fi

  echo "$response"
}

notion_get()   { _notion_request GET   "$1"; }
notion_post()  { _notion_request POST  "$1" "$2"; }
notion_patch() { _notion_request PATCH "$1" "$2"; }

# ---------------------------------------------------------------------------
# Resolve task No. → page_id
# ---------------------------------------------------------------------------
resolve_page_id() {
  local no="$1"
  local result page_id
  result=$(notion_post "/databases/${NOTION_DATABASE_ID}/query" \
    "{\"filter\":{\"property\":\"ID\",\"unique_id\":{\"equals\":${no}}}}")
  page_id=$(echo "$result" | jq -r '.results[0].id // empty')
  [[ -z "$page_id" ]] && die "No task found with No. = ${no}"
  echo "$page_id"
}

# ---------------------------------------------------------------------------
# Resolve email(s) → user ID(s)
#
# resolve_user_id  <email|uuid>  → single ID (echoed)
# resolve_user_ids <email[,...]> → sets global $_RESOLVED_PEOPLE (JSON array)
# ---------------------------------------------------------------------------
_users_json_cache=""

_fetch_users() {
  if [[ -z "$_users_json_cache" ]]; then
    _users_json_cache=$(notion_get "/users")
  fi
  echo "$_users_json_cache"
}

resolve_user_id() {
  local input="$1"
  # Pass UUIDs through unchanged
  if [[ "$input" =~ ^[0-9a-fA-F-]{32,36}$ ]]; then
    echo "$input"; return
  fi

  local users_json email_lower uid valid
  users_json=$(_fetch_users)
  email_lower="${input,,}"

  uid=$(echo "$users_json" | jq -r --arg e "$email_lower" '
    .results[] | select(.type == "person")
    | select((.person.email | ascii_downcase) == $e)
    | .id
  ' | head -1)

  if [[ -z "$uid" ]]; then
    valid=$(echo "$users_json" | jq -r \
      '[.results[] | select(.type=="person") | .person.email | ascii_downcase] | sort | join(", ")')
    die "Unknown email '${input}'. Valid emails: ${valid}"
  fi

  echo "$uid"
}

_RESOLVED_PEOPLE=""

resolve_user_ids() {
  local input="$1"
  local people_array="[]"

  IFS=',' read -ra raw_inputs <<< "$input"
  for raw in "${raw_inputs[@]}"; do
    local email uid
    email="${raw#"${raw%%[![:space:]]*}"}"
    email="${email%"${email##*[![:space:]]}"}"

    uid=$(resolve_user_id "$email")
    people_array=$(echo "$people_array" | jq \
      --arg id "$uid" \
      '. + [{"object":"user","id":$id}]')
  done

  _RESOLVED_PEOPLE="$people_array"
}

# ---------------------------------------------------------------------------
# Build a property patch body from type + value
# Used by both task create and task update
# ---------------------------------------------------------------------------
build_prop_body() {
  local prop_type="$1"
  local value="$2"

  case "$prop_type" in
    title)        jq -n --arg v "$value" '{title:        [{type:"text",text:{content:$v}}]}' ;;
    rich_text)    jq -n --arg v "$value" '{rich_text:    [{type:"text",text:{content:$v}}]}' ;;
    select)       jq -n --arg v "$value" '{select:       {name:$v}}' ;;
    status)       jq -n --arg v "$value" '{status:       {name:$v}}' ;;
    multi_select) jq -n --arg v "$value" \
                    '{multi_select: ($v | split(",") | map(ltrimstr(" ") | rtrimstr(" ")) | map({name:.}))}' ;;
    number)       jq -n --argjson v "$value" '{number: $v}' ;;
    checkbox)
      local bv="false"
      [[ "$value" == "true" || "$value" == "1" || "$value" == "yes" ]] && bv="true"
      jq -n --argjson v "$bv" '{checkbox: $v}' ;;
    url)          jq -n --arg v "$value" '{url:          $v}' ;;
    email)        jq -n --arg v "$value" '{email:        $v}' ;;
    phone_number) jq -n --arg v "$value" '{phone_number: $v}' ;;
    date)         jq -n --arg v "$value" '{date:         {start:$v}}' ;;
    relation)     jq -n --arg v "$value" '{relation:     [{id:$v}]}' ;;
    people)
      resolve_user_ids "$value"
      jq -n --argjson arr "$_RESOLVED_PEOPLE" '{people: $arr}' ;;
    *)  die "Property type '${prop_type}' is not supported for this operation." ;;
  esac
}

# ---------------------------------------------------------------------------
# Pretty-print a single property value
# ---------------------------------------------------------------------------
print_property() {
  local name="$1"
  local prop="$2"
  local type value=""
  type=$(echo "$prop" | jq -r '.type')

  case "$type" in
    title)            value=$(echo "$prop" | jq -r '.title | map(.plain_text) | join("")') ;;
    rich_text)        value=$(echo "$prop" | jq -r '.rich_text | map(.plain_text) | join("")') ;;
    number)           value=$(echo "$prop" | jq -r '.number // ""') ;;
    select)           value=$(echo "$prop" | jq -r '.select.name // ""') ;;
    multi_select)     value=$(echo "$prop" | jq -r '[.multi_select[].name] | join(", ")') ;;
    status)           value=$(echo "$prop" | jq -r '.status.name // ""') ;;
    date)             value=$(echo "$prop" | jq -r \
                        'if .date then (.date.start + (if .date.end then " → " + .date.end else "" end)) else "" end') ;;
    checkbox)         value=$(echo "$prop" | jq -r 'if .checkbox then "✓" else "✗" end') ;;
    url)              value=$(echo "$prop" | jq -r '.url // ""') ;;
    email)            value=$(echo "$prop" | jq -r '.email // ""') ;;
    phone_number)     value=$(echo "$prop" | jq -r '.phone_number // ""') ;;
    people)           value=$(echo "$prop" | jq -r '[.people[].name // .people[].id] | join(", ")') ;;
    relation)         value=$(echo "$prop" | jq -r '[.relation[].id] | join(", ")') ;;
    unique_id)        value=$(echo "$prop" | jq -r '(.unique_id.prefix // "") + (.unique_id.number | tostring)') ;;
    created_time)     value=$(echo "$prop" | jq -r '.created_time // ""') ;;
    last_edited_time) value=$(echo "$prop" | jq -r '.last_edited_time // ""') ;;
    created_by)       value=$(echo "$prop" | jq -r '.created_by.name // .created_by.id // ""') ;;
    last_edited_by)   value=$(echo "$prop" | jq -r '.last_edited_by.name // .last_edited_by.id // ""') ;;
    files)            value=$(echo "$prop" | jq -r '[.files[].name] | join(", ")') ;;
    *)                value="[type: $type]" ;;
  esac

  printf "  \033[1m%-25s\033[0m %s\n" "${name}:" "$value"
}

# ---------------------------------------------------------------------------
# noun: task
# ---------------------------------------------------------------------------

cmd_task_list() {
  local filter_prop="" filter_val="" sort_prop="" sort_dir="ascending" mine=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --filter) filter_prop="$2"; filter_val="$3"; shift 3 ;;
      --mine)
        [[ -z "${NOTION_USER_EMAIL:-}" ]] && die "--mine requires NOTION_USER_EMAIL in .env.notion"
        mine=1; shift ;;
      --sort)
        sort_prop="$2"; shift 2
        if [[ $# -gt 0 && "$1" =~ ^(asc|desc|ascending|descending)$ ]]; then
          sort_dir="$1"; shift
        fi
        ;;
      *) die "Unknown option: $1" ;;
    esac
  done

  # --mine sets an implicit people filter on the assignee column
  if [[ "$mine" -eq 1 ]]; then
    filter_prop="Assignee"
    filter_val="$NOTION_USER_EMAIL"
  fi

  [[ "$sort_dir" == "asc" ]]  && sort_dir="ascending"
  [[ "$sort_dir" == "desc" ]] && sort_dir="descending"

  local body="{}"

  if [[ -n "$filter_prop" && -n "$filter_val" ]]; then
    local schema prop_type real_prop_name
    schema=$(notion_get "/databases/${NOTION_DATABASE_ID}")

    prop_type=$(echo "$schema" | jq -r --arg p "$filter_prop" '
      .properties | to_entries[]
      | select((.key | ascii_downcase) == ($p | ascii_downcase))
      | .value.type
    ' | head -1)

    real_prop_name=$(echo "$schema" | jq -r --arg p "$filter_prop" '
      .properties | to_entries[]
      | select((.key | ascii_downcase) == ($p | ascii_downcase))
      | .key
    ' | head -1)

    case "$prop_type" in
      people)
        info "Resolving '${filter_val}' for people filter..."
        local uid; uid=$(resolve_user_id "$filter_val")
        body=$(jq -n --arg prop "${real_prop_name:-$filter_prop}" --arg uid "$uid" \
          '{filter: {property: $prop, people: {contains: $uid}}}') ;;
      created_by)
        info "Resolving '${filter_val}' for created_by filter..."
        local uid; uid=$(resolve_user_id "$filter_val")
        body=$(jq -n --arg prop "${real_prop_name:-$filter_prop}" --arg uid "$uid" \
          '{filter: {property: $prop, created_by: {contains: $uid}}}') ;;
      *)
        body=$(jq -n --arg prop "$filter_prop" --arg val "$filter_val" \
          '{filter: {or: [
              {property: $prop, rich_text:    {contains: $val}},
              {property: $prop, select:       {equals:   $val}},
              {property: $prop, status:       {equals:   $val}},
              {property: $prop, multi_select: {contains: $val}}
            ]}}') ;;
    esac
  fi

  if [[ -n "$sort_prop" ]]; then
    body=$(echo "$body" | jq --arg prop "$sort_prop" --arg dir "$sort_dir" \
      '. + {sorts: [{property: $prop, direction: $dir}]}')
  else
    body=$(echo "$body" | jq '. + {sorts: [{timestamp: "last_edited_time", direction: "descending"}]}')
  fi

  info "Fetching tasks..."
  local result count
  result=$(notion_post "/databases/${NOTION_DATABASE_ID}/query" "$body")
  count=$(echo "$result" | jq '.results | length')

  if [[ "$count" -eq 0 ]]; then
    yellow "No tasks found."
    return
  fi

  local statuses
  statuses=$(echo "$result" | jq -r --arg grp "$NOTION_STATUS_PROPERTY_NAME" '
    [.results[].properties
      | to_entries[]
      | select(.key == $grp)
      | .value
      | if   .type == "status" then .status.name
        elif .type == "select"  then .select.name
        else null end
      | select(. != null)
    ] | unique | .[]
  ')

  if [[ -z "$statuses" ]]; then
    yellow "No '${NOTION_STATUS_PROPERTY_NAME}' property found — listing flat:"
    echo "$result" | jq -r '
      .results[] |
      "  No." +
      (.properties | to_entries[] | select(.value.type=="unique_id") | .value.unique_id.number | tostring) +
      "  " +
      (.properties | to_entries[] | select(.value.type=="title") | .value.title | map(.plain_text) | join("") | if length > 80 then .[0:80] + "..." else . end)'
    return
  fi

  while IFS= read -r status; do
    [[ -z "$status" ]] && continue
    local group
    group=$(echo "$result" | jq -r --arg s "$status" --arg grp "$NOTION_STATUS_PROPERTY_NAME" '
      .results[]
      | select(
          (.properties | to_entries[] | select(.key==$grp) | .value
            | if   .type=="status" then .status.name
              elif .type=="select"  then .select.name
              else "" end
          ) == $s
        )
      | "  No." +
        (.properties | to_entries[] | select(.value.type=="unique_id") | .value.unique_id.number | tostring) +
        "  " +
        (.properties | to_entries[] | select(.value.type=="title") | .value.title | map(.plain_text) | join("") | if length > 80 then .[0:80] + "..." else . end)
    ')
    if [[ -n "$group" ]]; then
      echo ""
      bold "── $status ──────────────────────────────────────"
      echo "$group"
    fi
  done <<< "$statuses"

  local no_stage
  no_stage=$(echo "$result" | jq -r --arg grp "$NOTION_STATUS_PROPERTY_NAME" '
    .results[]
    | select(
        (.properties | to_entries[] | select(.key==$grp) | .value
          | if   .type=="status" then .status.name
            elif .type=="select"  then .select.name
            else null end
        ) == null
      )
    | "  No." +
      (.properties | to_entries[] | select(.value.type=="unique_id") | .value.unique_id.number | tostring) +
      "  " +
      (.properties | to_entries[] | select(.value.type=="title") | .value.title | map(.plain_text) | join("") | if length > 80 then .[0:80] + "..." else . end)
  ' 2>/dev/null || true)

  if [[ -n "$no_stage" ]]; then
    echo ""
    bold "── (no stage) ──────────────────────────────────"
    echo "$no_stage"
  fi

  echo ""
  dim "Total: $count tasks"
}

cmd_task_show() {
  local no="$1"
  info "Fetching task No. ${no}..."

  local page_id page
  page_id=$(resolve_page_id "$no")
  page=$(notion_get "/pages/${page_id}")

  echo ""
  bold "══════════════════════════════════════════════════"
  bold " Task No. ${no}"
  bold "══════════════════════════════════════════════════"
  echo ""
  bold "Properties:"

  echo "$page" | jq -c '.properties | to_entries[]' | while IFS= read -r entry; do
    local name val
    name=$(echo "$entry" | jq -r '.key')
    val=$(echo "$entry"  | jq -c '.value')
    print_property "$name" "$val"
  done

  local url
  url=$(echo "$page" | jq -r '.url // ""')
  echo ""
  dim "  URL: $url"

  echo ""
  bold "Comments:"
  local comments comment_count
  comments=$(notion_get "/comments?block_id=${page_id}")
  comment_count=$(echo "$comments" | jq '.results | length')

  if [[ "$comment_count" -eq 0 ]]; then
    dim "  (no comments)"
  else
    echo "$comments" | jq -r '.results[] |
      "  [" + .created_time[0:10] + "] " +
      (.created_by.name // "Unknown") + ": " +
      (.rich_text | map(.plain_text) | join(""))'
  fi
  echo ""
}

cmd_task_create() {
  local title=""
  declare -A extra_props=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title) title="$2"; shift 2 ;;
      --self)
        [[ -z "${NOTION_USER_EMAIL:-}" ]] && die "--self requires NOTION_USER_EMAIL in .env.notion"
        extra_props["assignee"]="$NOTION_USER_EMAIL"
        shift ;;
      --*)
        local key="${1#--}"
        extra_props["$key"]="$2"
        shift 2 ;;
      *) die "Unknown argument: $1" ;;
    esac
  done

  [[ -z "$title" ]] && die "You must provide --title \"...\" to create a task."

  local props
  props=$(jq -n --arg t "$title" --arg tprop "$NOTION_TITLE_PROPERTY_NAME" \
    '{($tprop): {title: [{type:"text",text:{content:$t}}]}}')

  if [[ ${#extra_props[@]} -gt 0 ]]; then
    local schema
    schema=$(notion_get "/databases/${NOTION_DATABASE_ID}")

    for key in "${!extra_props[@]}"; do
      local val="${extra_props[$key]}"

      local real_key ptype
      real_key=$(echo "$schema" | jq -r --arg k "$key" '
        .properties | to_entries[]
        | select((.key | ascii_downcase) == ($k | ascii_downcase))
        | .key
      ' | head -1)

      if [[ -z "$real_key" ]]; then
        yellow "Warning: property '${key}' not found in schema, skipping."
        continue
      fi

      ptype=$(echo "$schema" | jq -r --arg k "$real_key" '.properties[$k].type')

      local patch
      patch=$(build_prop_body "$ptype" "$val") || continue
      props=$(echo "$props" | jq --arg k "$real_key" --argjson p "$patch" '.[$k] = $p')
    done
  fi

  local body result new_id url
  body=$(jq -n --arg db "$NOTION_DATABASE_ID" --argjson props "$props" \
    '{parent: {database_id: $db}, properties: $props}')

  result=$(notion_post "/pages" "$body")

  new_id=$(echo "$result" | jq -r '
    .properties | to_entries[]
    | select(.value.type=="unique_id")
    | .value.unique_id.number | tostring
  ')
  url=$(echo "$result" | jq -r '.url')

  green "✓ Task created!"
  [[ -n "$new_id" ]] && echo "  No.  : $new_id"
  echo "  URL  : $url"
}

cmd_task_update() {
  local no="$1" prop="$2" value="$3"

  info "Fetching task No. ${no}..."
  local page_id page
  page_id=$(resolve_page_id "$no")
  page=$(notion_get "/pages/${page_id}")

  local real_prop
  real_prop=$(echo "$page" | jq -r --arg p "$prop" '
    .properties | to_entries[]
    | select((.key | ascii_downcase) == ($p | ascii_downcase))
    | .key
  ' | head -1)
  [[ -z "$real_prop" ]] && die "Property '${prop}' not found on task No. ${no}."

  local prop_type prop_body body
  prop_type=$(echo "$page" | jq -r --arg p "$real_prop" '.properties[$p].type')
  prop_body=$(build_prop_body "$prop_type" "$value")

  # Auto-comment on status changes to maintain audit trail (per RULES.md)
  if [[ "$prop_type" == "status" || "$prop_type" == "select" ]] && \
     [[ "${real_prop,,}" == "status" ]]; then
    local old_status audit_text
    old_status=$(echo "$page" | jq -r --arg p "$real_prop" \
      '.properties[$p] | if .type == "status" then .status.name elif .type == "select" then .select.name else "" end')
    audit_text="Status → **${value}**"
    [[ -n "$old_status" ]] && audit_text="Status: ~~${old_status}~~ → **${value}**"
    cmd_comment_add "$no" "$audit_text" "$page_id"
  fi

  body=$(jq -n --arg p "$real_prop" --argjson pb "$prop_body" '{properties: {($p): $pb}}')
  notion_patch "/pages/${page_id}" "$body" > /dev/null
  green "✓ Updated '${real_prop}' on task No. ${no} → ${value}"
}

cmd_task_assign() {
  local no="$1" handles_input="${2:-}"

  # --self shorthand
  if [[ "$handles_input" == "--self" || -z "$handles_input" ]]; then
    if [[ "$handles_input" == "--self" ]]; then
      [[ -z "${NOTION_USER_EMAIL:-}" ]] && die "--self requires NOTION_USER_EMAIL in .env.notion"
      handles_input="$NOTION_USER_EMAIL"
    else
      die "Usage: notion task assign <No.> <email[,email,...]|--self>"
    fi
  fi

  info "Resolving emails..."
  resolve_user_ids "$handles_input"
  local people_array="$_RESOLVED_PEOPLE"

  info "Fetching task No. ${no}..."
  local page_id page prop_name
  page_id=$(resolve_page_id "$no")
  page=$(notion_get "/pages/${page_id}")

  prop_name=$(echo "$page" | jq -r '
    .properties | to_entries[] | select(.value.type == "people") | .key
  ' | head -1)
  [[ -z "$prop_name" ]] && die "No 'people' property found on task No. ${no}."

  local body
  body=$(jq -n --arg p "$prop_name" --argjson arr "$people_array" \
    '{properties: {($p): {people: $arr}}}')

  notion_patch "/pages/${page_id}" "$body" > /dev/null
  green "✓ Assigned '${prop_name}' on task No. ${no} → ${handles_input}"
}

cmd_task_unassign() {
  local no="$1" handles_input="$2"
  [[ -z "$handles_input" ]] && die "Usage: notion task unassign <No.> <email[,email,...]>"

  info "Fetching task No. ${no}..."
  local page_id page prop_name
  page_id=$(resolve_page_id "$no")
  page=$(notion_get "/pages/${page_id}")

  prop_name=$(echo "$page" | jq -r '
    .properties | to_entries[] | select(.value.type == "people") | .key
  ' | head -1)
  [[ -z "$prop_name" ]] && die "No 'people' property found on task No. ${no}."

  # Build set of IDs to remove
  local remove_ids="[]"
  IFS=',' read -ra raw_inputs <<< "$handles_input"
  for raw in "${raw_inputs[@]}"; do
    local email uid
    email="${raw#"${raw%%[![:space:]]*}"}"
    email="${email%"${email##*[![:space:]]}"}"

    uid=$(resolve_user_id "$email")

    local currently_assigned
    currently_assigned=$(echo "$page" | jq -r \
      --arg p "$prop_name" --arg id "$uid" \
      '.properties[$p].people[]? | select(.id == $id) | .id')

    if [[ -z "$currently_assigned" ]]; then
      yellow "Warning: '${email}' is not currently assigned to task No. ${no}, skipping."
      continue
    fi

    remove_ids=$(echo "$remove_ids" | jq --arg id "$uid" '. + [$id]')
  done

  local new_people body
  new_people=$(echo "$page" | jq \
    --arg p "$prop_name" \
    --argjson rm "$remove_ids" \
    '.properties[$p].people | map(select(.id as $id | $rm | index($id) == null)) | map({object:"user",id:.id})')

  body=$(jq -n --arg p "$prop_name" --argjson arr "$new_people" \
    '{properties: {($p): {people: $arr}}}')

  notion_patch "/pages/${page_id}" "$body" > /dev/null
  green "✓ Unassigned [${handles_input}] from task No. ${no}"
}

