#!/usr/bin/env bash
# =============================================================================
# arxys — Arxoft Workspace CLI
# =============================================================================
# Usage:
#   arxys notion [--db <id|alias>] task    <action> [args]
#   arxys notion [--db <id|alias>] comment <action> [args]
#   arxys notion [--db <id|alias>] user    <action>
#   arxys notion [--db <id|alias>] db      <action>
#   arxys notion rules
#   arxys notion workflow list|show <name>
#   arxys github pr      list|show|create|merge|review [args]
#   arxys github issue   list|show|create|update|comment [args]
#   arxys github repo    info|list [args]
#
# Setup:
#   ln -s "$(pwd)/arxys" ~/.local/bin/arxys
#
# See README.md for full documentation.
# =============================================================================

set -uo pipefail

# ---------------------------------------------------------------------------
# Resolve the real directory of this script, following symlinks
# ---------------------------------------------------------------------------
_resolve_script_dir() {
  local src="${BASH_SOURCE[0]}"
  while [[ -L "$src" ]]; do
    local dir; dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="${dir}/${src}"
  done
  cd -P "$(dirname "$src")" && pwd
}
SCRIPT_DIR="$(_resolve_script_dir)"
unset -f _resolve_script_dir

LIB_DIR="${SCRIPT_DIR}/lib"

# ---------------------------------------------------------------------------
# Load shared utilities
# ---------------------------------------------------------------------------
# shellcheck source=lib/common.sh
source "${LIB_DIR}/common.sh"

# ---------------------------------------------------------------------------
# Config — load .env.arxys from the working directory
# ---------------------------------------------------------------------------
ENV_FILE="${PWD}/.env.arxys"

declare -A _NOTION_DB_ALIASES=()

if [[ -f "$ENV_FILE" ]]; then
  while IFS= read -r _line || [[ -n "$_line" ]]; do
    _line="${_line%%#*}"
    _line="${_line//[$'\r']}"
    [[ -z "${_line// }" ]] && continue
    _key="${_line%%=*}"
    _val="${_line#*=}"
    _key="${_key#"${_key%%[![:space:]]*}"}" ; _key="${_key%"${_key##*[![:space:]]}"}"
    _val="${_val#"${_val%%[![:space:]]*}"}" ; _val="${_val%"${_val##*[![:space:]]}"}"
    _val="${_val#\"}" ; _val="${_val%\"}"
    _val="${_val#\'}" ; _val="${_val%\'}"
    if [[ "$_key" =~ ^NOTION_DATABASE_ID:(.+)$ ]]; then
      _alias="${BASH_REMATCH[1],,}"
      _NOTION_DB_ALIASES["$_alias"]="$_val"
    elif [[ "$_key" =~ ^NOTION_ || "$_key" =~ ^GITHUB_ ]]; then
      export "$_key"="$_val"
    fi
  done < "$ENV_FILE"
  unset _line _key _val
fi

NOTION_API_KEY="${NOTION_API_KEY:-}"
NOTION_DATABASE_ID="${NOTION_DATABASE_ID:-}"
NOTION_USER="${NOTION_USER:-}"
NOTION_USER_EMAIL="${NOTION_USER_EMAIL:-}"
NOTION_STATUS_PROPERTY_NAME="Status"
NOTION_TITLE_PROPERTY_NAME="${NOTION_TITLE_PROPERTY_NAME:-Task name}"
NOTION_VERSION="2022-06-28"
NOTION_BASE_URL="https://api.notion.com/v1"

GITHUB_TOKEN="${GITHUB_TOKEN:-}"

# ---------------------------------------------------------------------------
# Dispatch: github
# ---------------------------------------------------------------------------
_dispatch_github() {
  source "${LIB_DIR}/github/common.sh"

  local noun="${1:-help}"; shift || true

  case "$noun" in
    pr)
      source "${LIB_DIR}/github/pr.sh"
      local verb="${1:-list}"; shift || true
      case "$verb" in
        list)   cmd_pr_list "$@" ;;
        show)   cmd_pr_show "$@" ;;
        create) cmd_pr_create "$@" ;;
        merge)  cmd_pr_merge "$@" ;;
        review) cmd_pr_review "$@" ;;
        files)  cmd_pr_files "$@" ;;
        status) cmd_pr_status "$@" ;;
        *) die "Unknown verb '${verb}' for 'pr'. Try: list, show, create, merge, review, files, status" ;;
      esac
      ;;

    issue)
      source "${LIB_DIR}/github/issue.sh"
      local verb="${1:-list}"; shift || true
      case "$verb" in
        list)    cmd_issue_list "$@" ;;
        show)    cmd_issue_show "$@" ;;
        create)  cmd_issue_create "$@" ;;
        update)  cmd_issue_update "$@" ;;
        comment) cmd_issue_comment "$@" ;;
        *) die "Unknown verb '${verb}' for 'issue'. Try: list, show, create, update, comment" ;;
      esac
      ;;

    repo)
      source "${LIB_DIR}/github/repo.sh"
      local verb="${1:-info}"; shift || true
      case "$verb" in
        info)    cmd_repo_info "$@" ;;
        list)    cmd_repo_list "$@" ;;
        commits) cmd_repo_commits "$@" ;;
        search)  cmd_repo_search "$@" ;;
        *) die "Unknown verb '${verb}' for 'repo'. Try: info, list, commits, search" ;;
      esac
      ;;

    user)
      source "${LIB_DIR}/github/user.sh"
      local verb="${1:-}"; shift || true
      case "$verb" in
        search) cmd_github_user_search "$@" ;;
        *) die "Unknown verb '${verb}' for 'user'. Try: search" ;;
      esac
      ;;

    help|--help|-h) _github_help ;;
    *) die "Unknown resource '${noun}'. Run 'arxys github help' for usage." ;;
  esac
}

