# ---------------------------------------------------------------------------
# Main entry point
# ---------------------------------------------------------------------------
TOOL="${1:-help}"; shift || true

case "$TOOL" in
  notion) _dispatch_notion "$@" ;;
  github) _dispatch_github "$@" ;;
  help|--help|-h)
