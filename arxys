# ---------------------------------------------------------------------------
# Dispatch: notion
# ---------------------------------------------------------------------------
_dispatch_notion() {
  require_deps

  # --db override must come before the noun
  local _DB_OVERRIDE=""
  local -a _REMAINING=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --db)
        [[ $# -lt 2 ]] && die "--db requires an argument"
        _DB_OVERRIDE="$2"; shift 2 ;;
      *) _REMAINING+=("$1"); shift ;;
    esac
  done
  set -- "${_REMAINING[@]+"${_REMAINING[@]}"}"
  unset _REMAINING

  if [[ -n "$_DB_OVERRIDE" ]]; then
    if [[ "$_DB_OVERRIDE" =~ ^[0-9a-fA-F-]{32,36}$ ]]; then
      NOTION_DATABASE_ID="$_DB_OVERRIDE"
    else
      local _alias_lower="${_DB_OVERRIDE,,}"
      local _ALIAS_VAL="${_NOTION_DB_ALIASES[$_alias_lower]:-}"
      if [[ -z "$_ALIAS_VAL" ]]; then
        die "DB alias '${_DB_OVERRIDE}' not found. Run 'arxys notion db list' to see available aliases."
      fi
      NOTION_DATABASE_ID="$_ALIAS_VAL"
    fi
  fi
  unset _DB_OVERRIDE

  local noun="${1:-help}"; shift || true

  case "$noun" in
    task)
      require_env
      source "${LIB_DIR}/notion/comment.sh"
      source "${LIB_DIR}/notion/task.sh"
      local verb="${1:-list}"; shift || true
      case "$verb" in
        list)     cmd_task_list "$@" ;;
        show)     cmd_task_show "$@" ;;
        create)   cmd_task_create "$@" ;;
        update)   cmd_task_update "$@" ;;
        assign)   cmd_task_assign "$@" ;;
        unassign) cmd_task_unassign "$@" ;;
        *) die "Unknown verb '${verb}' for 'task'. Try: list, show, create, update, assign, unassign" ;;
      esac
      ;;

    comment)
      require_env
      source "${LIB_DIR}/notion/comment.sh"
      local verb="${1:-}"; shift || true
      case "$verb" in
        add) cmd_comment_add "$@" ;;
        *)   die "Unknown verb '${verb}' for 'comment'. Try: add" ;;
      esac
      ;;

    user)
      require_env
      source "${LIB_DIR}/notion/user.sh"
      local verb="${1:-list}"; shift || true
      case "$verb" in
        list) cmd_user_list ;;
        *) die "Unknown verb '${verb}' for 'user'. Try: list" ;;
      esac
      ;;

    db)
      source "${LIB_DIR}/notion/db.sh"
      local verb="${1:-list}"; shift || true
      case "$verb" in
        list) cmd_db_list ;;
        bootstrap)
          if [[ $# -gt 0 && ( "$1" == "--help" || "$1" == "-h" || "$1" == "help" ) ]]; then
            cmd_db_bootstrap_help
          else
            require_env
            cmd_db_bootstrap "$@"
          fi
          ;;
        *) die "Unknown verb '${verb}' for 'db'. Try: list, bootstrap" ;;
      esac
      ;;

    rules)
      source "${LIB_DIR}/notion/rules.sh"
      cmd_rules
      ;;

    workflow)
      source "${LIB_DIR}/notion/workflow.sh"
      local verb="${1:-list}"; shift || true
      case "$verb" in
        list) cmd_workflow_list ;;
        show)
          [[ $# -lt 1 ]] && die "Usage: arxys notion workflow show <name>"
          cmd_workflow_show "$1" ;;
        *) die "Unknown verb '${verb}' for 'workflow'. Try: list, show" ;;
      esac
      ;;

    help|--help|-h) _notion_help ;;
    *) die "Unknown resource '${noun}'. Run 'arxys notion help' for usage." ;;
  esac
}

