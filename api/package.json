{
  "name": "arxys-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev":    "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local":  "wrangler d1 migrations apply arxys-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply arxys-db --remote",
    "db:console:local":  "wrangler d1 execute arxys-db --local --command",
    "db:console:remote": "wrangler d1 execute arxys-db --remote --command"
  },
  "dependencies": {
    "hono": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240903.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.0.0"
  }
}
