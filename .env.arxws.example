NOTION_API_KEY=                          # ntn_xxxx — from notion.so/profile/integrations
NOTION_DATABASE_ID=                      # default database — from board URL: notion.so/.../<ID>?v=...
NOTION_DATABASE_ID:VENTURES=             # optional alias: arxws notion --db ventures
NOTION_DATABASE_ID:CLIENTS=             # optional alias: arxws notion --db clients
NOTION_TITLE_PROPERTY_NAME=Title         # name of the title property in your database (default: "Title")
NOTION_USER=                             # your short name/handle — prefixes every comment e.g. (ako)
NOTION_USER_EMAIL=                       # your workspace email — used for --self and --mine

GITHUB_TOKEN=                            # ghp_xxxx — PAT with repo scope (Settings → Developer settings → PATs)
# No GITHUB_OWNER or GITHUB_REPO — owner/repo is always passed via --repo on each command.
# e.g.  arxws github pr list --repo acme-corp/backend
