NOTION_API_KEY=                          # ntn_xxxx — from notion.so/profile/integrations
NOTION_DATABASE_ID=                      # default database — from board URL: notion.so/.../<ID>?v=...
NOTION_DATABASE_ID:VENTURES=             # optional alias: arxys notion --db ventures
NOTION_DATABASE_ID:CLIENTS=             # optional alias: arxys notion --db clients
NOTION_TITLE_PROPERTY_NAME=Title         # name of the title property in your database (default: "Title")
NOTION_USER=                             # your short name/handle — prefixes every comment e.g. (ako)
NOTION_USER_EMAIL=                       # your workspace email — used for --self and --mine

GITHUB_TOKEN=                            # ghp_xxxx — PAT with repo scope (Settings → Developer settings → PATs)
# No GITHUB_OWNER or GITHUB_REPO — owner/repo is always passed via --repo on each command.
# e.g.  arxys github pr list --repo acme-corp/backend

# ---------------------------------------------------------------------------
# Slack notifications (optional)
# Both must be set to enable notifications; if either is absent, all
# slack_notify calls silently skip — existing workflows are unaffected.
#
# Setup:
#   1. api.slack.com/apps → Create New App → From scratch
#   2. OAuth & Permissions → Bot Token Scopes → add chat:write
#   3. Install to Workspace → copy Bot User OAuth Token (xoxb-...)
#   4. Right-click the target channel in Slack → View channel details
#      → scroll to bottom → copy Channel ID (starts with C)
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=                         # xoxb-xxxx — bot user OAuth token
SLACK_CHANNEL_ID=                        # Cxxxxxxxxxx — target channel ID
